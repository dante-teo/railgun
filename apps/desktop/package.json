{
  "name": "railgun-desktop",
  "version": "0.13.0",
  "description": "Railgun desktop application",
  "author": "Dante Teo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dante-teo/railgun.git"
  },
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.12.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "node --test scripts/*.test.mjs src/main/*.test.mts src/preload/*.test.mts && vitest run",
    "test:ui": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "prestart": "node scripts/ensure-electron.mjs",
    "start": "electron-vite preview",
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build:backend": "cargo build --locked --release --package railgun-backend --manifest-path ../../Cargo.toml",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "node scripts/ensure-electron.mjs && electron-builder install-app-deps",
    "build:unpack": "pnpm run build:backend && pnpm run build && electron-builder --dir --mac --arm64 --config.forceCodeSigning=false --config.mac.identity=null --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "build:mac": "pnpm run build:backend && pnpm run build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "croner": "^10.0.1",
    "electron-updater": "6.8.9",
    "plist": "^5.0.0",
    "radix-ui": "^1.6.7",
    "react-resizable-panels": "^4.12.2",
    "streamdown": "^2.5.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.30.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.3.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  }
}
